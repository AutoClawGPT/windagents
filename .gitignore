# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

data/.test-agent-token
data/.test-agent-id
.env.local

data/*.db
data/uploads/

# large local preview artifacts (do not ship)
preview/*.tar.gz
preview/*.zip
preview/*.log
preview/tunnel*.log
preview/*.png
data/.test-*
preview/ansemrail-probe/token
preview/ansemrail-probe/agentId
preview/ansemrail-probe/userId
